# ---------------------------------------------------------------------------
# SecureKey - configuracion de desarrollo
#
# COPIA este fichero a `.env` y ejecuta `npm run secrets` (dentro de Docker)
# para generar los secretos. NUNCA subas `.env` al repositorio.
# ---------------------------------------------------------------------------

# Puerto y origen publicos de la aplicacion.
#
# En PRODUCCION `APP_PORT` no se usa: el compose de produccion publica el 443
# con `!override`, que reemplaza la lista heredada. Aqui 8443 es lo unico que
# se publica.
APP_PORT=8443
APP_ORIGIN=https://localhost:8443

# --- PRODUCCION -------------------------------------------------------------
# Los cuatro de abajo SOLO se rellenan para desplegar en una VPS:
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# APP_HOST
#   El dominio real, sin esquema ni barra final. Lo usa el Caddyfile.prod para
#   pedir el certificado a Let's Encrypt y para las cabeceras de seguridad.
APP_HOST=

# APP_ORIGIN y ALLOWED_ORIGINS (abajo, seccion "Aplicacion")
#   Poner aqui el dominio real. Si se dejan con `localhost:8443`, la API
#   responde 403 al registro y al login: el hook `onRequest` rechaza todo
#   `Origin` que no este en la lista. Es un error desconcertante si no se sabe.
#
# CF_API_TOKEN
#   API Token de Cloudflare con permiso de edicion de DNS, limitado a la zona
#   del dominio. Lo necesita el desafio DNS-01 de Let's Encrypt, que es el
#   unico que funciona si el puerto 80 ya lo ocupa otro servidor (un nginx que
#   sirva otras aplicaciones, por ejemplo).
#
#   Crearlo en: Cloudflare > Mi perfil > API Tokens > Crear token > Token
#   personalizado > Permisos: Zone / DNS / Edit > Recursos: Incluir / Zona
#   especifica / yal99.com
#
#   Sin este token el contenedor NO arranca, a proposito: es preferible fallar
#   en el despliegue que quedarse renewing en silencio hasta que caduque el
#   certificado. Se rota en Cloudflare y se cambia aqui; no hay que tocar nada
#   mas.
CF_API_TOKEN=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=securekey
POSTGRES_USER=securekey
# Generado por `npm run secrets` (min. 32 caracteres)
POSTGRES_PASSWORD=

# Contrasena del rol `securekey_api`, con el que entra la API y el podador.
#
# DISTINTA de POSTGRES_PASSWORD a proposito. La API NO es superusuario: con el
# rol de migracion, un RCE en la API permitiria leer ficheros del host
# (pg_read_file) y ejecutar comandos (COPY ... TO PROGRAM), y la RLS de `items`
# —la unica barrera de la boveda— se quedaria a un SET LOCAL ROLE de distancia.
# Con este rol, ninguna de las dos cosas existe.
#
# La genera `npm run secrets`. Rotarla no requiere nada mas: el servicio
# `migrate` la reaplica en el siguiente arranque.
DATABASE_APP_PASSWORD=

# --- Aplicacion ------------------------------------------------------------
# Pepper del servidor para el hash del verificador de autenticacion.
# Generado por `npm run secrets` (min. 32 bytes en base64).
AUTH_PEPPER=

# Origenes permitidos para CORS/CSRF, separados por coma.
# En produccion: el dominio real, no el de desarrollo.
ALLOWED_ORIGINS=https://localhost:8443

# --- Politicas de sesion ----------------------------------------------------
SESSION_TTL_HOURS=24
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Parametros de derivacion (minimos OWASP: m>=19456 KiB, t>=2, p>=1) ----
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
ARGON2_KDF_VERSION=1

# --- Registro ---------------------------------------------------------------
# 'open' = cualquiera puede registrarse. 'invite' = requiere codigo valido.
#
# ESTA INSTANCIA ESTA EN 'open' A PROPOSITO: es una demo de porfolio y cualquiera
# tiene que poder entrar para ver el proyecto. La pantalla de registro avisa de
# que es una demo y de que no se guarden contrasenas reales.
#
# CAMBIARLO A 'invite' EN CUALQUIER USO REAL. En 'open', cualquiera que
# descubra la URL puede crear una cuenta y guardar en tu servidor las
# contrasenas que quiera. El limite de registros por IP no ayuda: un atacante
# con 50 IPs crea 50 cuentas, y sin 2FA, si alguien guarda su contrasena real
# del banco, quien compromise el servidor la lee.
REGISTRATION_MODE=open
# Clave para firmar los codigos de invitacion. OBLIGATORIA con 'invite'.
#
# Tratala como una credencial mas: quien la tenga puede emitir invitaciones
# ilimitadas, y los codigos no son de un solo uso. Emitir con:
#
#   npm run invite -- tu@correo.com
#
# Rotarla invalida todos los codigos emitidos antes, usados o no.
INVITE_SECRET=

# --- Retencion de la bitacora de seguridad ----------------------------------
# `audit_log` recibe una fila por cada login fallido, desde la red y SIN
# autenticar, y cada fila cuesta el heap mas tres indices. Sin retencion, el
# disco se llena solo: es una denegacion de servicio gratuita para quien sepa
# la URL. El servicio `prune` de docker-compose aplica estos dos topes.
#
#   AUDIT_KEEP_DAYS  antiguedad maxima
#   AUDIT_MAX_ROWS   cota dura de filas, por si un ataque dispara el caudal
#                    entre dos podas
AUDIT_KEEP_DAYS=30
AUDIT_MAX_ROWS=500000
