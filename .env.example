# ---------------------------------------------------------------------------
# SecureKey - configuracion de desarrollo
#
# COPIA este fichero a `.env` y ejecuta `npm run secrets` (dentro de Docker)
# para generar los secretos. NUNCA subas `.env` al repositorio.
# ---------------------------------------------------------------------------

# Puerto y origen publicos de la aplicacion
APP_PORT=8443
APP_ORIGIN=https://localhost:8443

# Solo para PRODUCCION. El dominio real, sin esquema ni barra final: lo usa el
# Caddyfile.prod para pedir el certificado a Let's Encrypt.
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
APP_HOST=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=securekey
POSTGRES_USER=securekey
# Generado por `npm run secrets` (min. 32 caracteres)
POSTGRES_PASSWORD=

# --- Aplicacion ------------------------------------------------------------
# Pepper del servidor para el hash del verificador de autenticacion.
# Generado por `npm run secrets` (min. 32 bytes en base64).
AUTH_PEPPER=

# Origenes permitidos para CORS/CSRF, separados por coma
ALLOWED_ORIGINS=https://localhost:8443

# --- Politicas de sesion ----------------------------------------------------
SESSION_TTL_HOURS=24
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Parametros de derivacion (minimos OWASP: m>=19456 KiB, t>=2, p>=1) ----
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
ARGON2_KDF_VERSION=1

# --- Registro ---------------------------------------------------------------
# 'open' = cualquiera puede registrarse. 'invite' = requiere codigo valido.
#
# EN UNA VPS PUBLICA PON 'invite'. Con 'open', cualquiera que descubra la URL
# puede crear una cuenta y guardar en tu servidor las credenciales que quiera.
# El limite de 5 registros/hora por IP no ayuda: un atacante con 50 IPs crea
# 50 cuentas por hora.
REGISTRATION_MODE=invite
# Clave para firmar los codigos de invitacion. OBLIGATORIA con 'invite'.
#
# Tratala como una credencial mas: quien la tenga puede emitir invitaciones
# ilimitadas, y los codigos no son de un solo uso. Emitir con:
#
#   npm run invite -- tu@correo.com
#
# Rotarla invalida todos los codigos emitidos antes, usados o no.
INVITE_SECRET=

# --- Retencion de la bitacora de seguridad ----------------------------------
# `audit_log` recibe una fila por cada login fallido, desde la red y SIN
# autenticar, y cada fila cuesta el heap mas tres indices. Sin retencion, el
# disco se llena solo: es una denegacion de servicio gratuita para quien sepa
# la URL. El servicio `prune` de docker-compose aplica estos dos topes.
#
#   AUDIT_KEEP_DAYS  antiguedad maxima
#   AUDIT_MAX_ROWS   cota dura de filas, por si un ataque dispara el caudal
#                    entre dos podas
AUDIT_KEEP_DAYS=30
AUDIT_MAX_ROWS=500000
