# ===========================================================================
# Caddy en la VPS: unico punto de entrada, con TLS propio.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# LA TOPOLOGIA, y por que es como es:
#
# En esa VPS hay un nginx que sirve tres aplicaciones mas y que ya ocupa los
# puertos 80 y 443. Un puerto solo lo puede escuchar un servicio, asi que
# SecureKey NO puede salir por ahi. Este Caddy toma el 443 (que estaba
# publicado pero libre: nada escuchaba en el) y nginx se queda con el 80 para
# las demas.
#
# 1. El 443 lo pide Let's Encrypt con el desafio DNS-01, no con el HTTP-01.
#
#    El HTTP-01 necesita el puerto 80, que es de nginx. El DNS-01 no necesita
#    ningun puerto: Caddy solo tiene que crear un registro TXT en la zona y
#    pedir que lo confirme la CA. Por eso `auto_https disable_redirects` mas
#    abajo y la ausencia de un bloque `http://`: sin las dos cosas, Caddy
#    intentaria escuchar en el 80 al montar la configuracion y el contenedor
#    no arrancaria.
#
#    Requiere un API Token de Cloudflare con permiso de edicion de DNS. Ver
#    `.env.example` y `docs/despliegue-vps.md`.
#
# 2. Como el registro DNS esta en "solo DNS" (nube gris), el trafico NO pasa
#    por Cloudflare: va del navegador directamente a este Caddy. Por eso el
#    certificado tiene que ser de una CA publica y no un certificado interno.
#
# 3. `header_up X-Forwarded-For {remote_host}` sigue siendo lo correcto: Caddy
#    es el primer salto, asi que `{remote_host}` ES la IP real del cliente. Si
#    algun dia se pone este Caddy detras de otro proxy, esa linea hay que
#    cambiarla por la cabecera que envie ese proxy; dejarla como esta seria
#    perder la IP en el `audit_log` y dejar el rate limit inservible.
#
# REQUISITOS, en este orden o no funciona:
#   - Registro DNS `A` con la IP de la VPS, en modo "solo DNS" (nube gris).
#   - Puerto 443 libre en el host. Si algo lo ocupa, esto no arranca.
#   - `APP_HOST`, `APP_ORIGIN`, `ALLOWED_ORIGINS` y `CF_API_TOKEN` en el `.env`.
#     Si `APP_ORIGIN` o `ALLOWED_ORIGINS` no se cambian, la API responde 403 al
#     registro y al login: el hook `onRequest` rechaza todo `Origin` que no
#     este en la lista.
# ===========================================================================

{
	admin off
	auto_https disable_redirects
}

# El dominio sale del entorno, para no tocar este fichero al cambiar de host.
{$APP_HOST} {
	# Let's Encrypt por DNS-01 contra la zona de Cloudflare. Sin este bloque
	# Caddy pediria el certificado por HTTP-01, que necesita el 80 y fallaria
	# porque ese puerto es de nginx.
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), clipboard-read=(self), clipboard-write=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# Sin 'unsafe-inline' ni 'unsafe-eval'. 'wasm-unsafe-eval' es
		# obligatorio: el Argon2id del cliente es WebAssembly y
		# `WebAssembly.compile()` lo gobierna `script-src`. Sin esta fuente no
		# se puede ni registrarse. Es mucho mas estrecho que 'unsafe-eval':
		# solo habilita WebAssembly.compile/instantiate, no eval().
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; manifest-src 'self'"

		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
		level INFO
	}

	# Ver el comentario del Caddyfile de desarrollo: en Caddy 2.11 hace falta un
	# log con nombre mas `log_name` para silenciar la sonda de salud.
	log salud {
		output discard
	}

	route {
		handle /api/* {
			# OJO: la sonda la responde la API de verdad. Servirla desde aqui
			# ocultaria una base de datos caida, que es justo lo que un monitor
			# viene a detectar.
			@health path /api/v1/health
			route @health {
				log_name salud
				reverse_proxy api:3000
			}

			reverse_proxy api:3000 {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-For {remote_host}
			}
		}

		handle {
			reverse_proxy web:80 {
				header_up X-Forwarded-Proto https
			}
		}
	}
}

# NO hay bloque `http://{$APP_HOST}` a proposito, y no es un olvido.
#
# El puerto 80 de esa VPS es del nginx que sirve las demas aplicaciones, asi que
# Caddy no puede escucharlo. La redireccion de http a https la pone un fichero
# aparte en el nginx (`conf.d/securekey.conf`), que ademas es necesario: sin
# el, `http://securekey.yal99.com` caeria en el primer `server` de nginx
# (jwaddresses) y serviria otra aplicacion bajo el nombre de este dominio.
