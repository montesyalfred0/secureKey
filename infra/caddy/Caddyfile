# ===========================================================================
# Caddy como unico punto de entrada.
#
# - TLS con CA interna (`tls internal`): la app se sirve por https y asi
#   `crypto.subtle` existe (contexto seguro) sin excepciones ni certificados
#   comprados.
# - Cabeceras de seguridad, incluida una CSP sin 'unsafe-inline'.
# - /api va a la API y el resto al frontend. Un solo origen: sin CORS.
# ===========================================================================

{
	admin off
	# Sin persistencia de la config en disco: el contenedor es efimero.
	auto_https disable_redirects
}

https://localhost:8443 {
	tls internal

	encode zstd gzip

	# ---------------------------------------------------------------------
	# Cabeceras
	# ---------------------------------------------------------------------
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# `clipboard-*=(self)` no es solo defensa: documenta que el
		# portapapeles es competencia de ESTA pagina, e impide que un contexto
		# embebido lea lo que el usuario copia de su boveda.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), clipboard-read=(self), clipboard-write=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# Sin 'unsafe-inline' ni 'unsafe-eval'. El bundle de Vite es un
		# fichero externo y no evalua nada, asi que se puede ser estricto.
		# Si alguien rompe la app por esto, la causa real es un XSS.
		#
		# PERO 'wasm-unsafe-eval' es obligatorio y no es una concession: el
		# Argon2id del cliente (hash-wasm) viene compilado como WebAssembly, y
		# `WebAssembly.compile()` lo gobierna la directiva `script-src`. Sin
		# esta fuente, el navegador rechaza el modulo y NO SE PUEDE REGISTRAR
		# NI INICIAR SESION: el error sale al derivada la clave maestra.
		#
		# Es mucho mas estrecho que 'unsafe-eval': solo habilita
		# `WebAssembly.compile/instantiate`, no `eval()` ni `new Function()`. Un
		# XSS sigue sin poder ejecutar JavaScript arbitrario.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' ws://localhost:8443 wss://localhost:8443; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; manifest-src 'self'"

		-Server
	}

	# ---------------------------------------------------------------------
	# API: nunca servida desde disco, siempre reenviada.
	# ---------------------------------------------------------------------
	# ---------------------------------------------------------------------
	# Access log.
	#
	# Antes esto era `output discard`, y en una VPS publica eso significaba no
	# tener ninguna forma de ver un ataque en curso: ni escaneo de puertos, ni
	# fuerza bruta, ni IPs. El `audit_log` de la app cubre acciones, no el
	# sondeo de la capa HTTP, y lo escribe justo la aplicacion a la que estan
	# atacando.
	#
	# JSON para poder filtrar por codigo, ruta o IP con `jq` sin parsear texto.
	# Y ROTACION, porque un log sin rotar en un servidor publico es un vector de
	# llenado de disco igual de serio que el que acabamos de tapar en
	# audit_log: basta con pedir URLs de 8 kB.
	#
	# `no_log` en /healthz evita que el healthcheck de Docker llene el log de
	# ruido cada 10 segundos.
	# ---------------------------------------------------------------------
	# `exclude` deja pasar la sonda de salud sin ensuciar el log con una linea
	# cada 10 segundos. OJO: NO se responde desde aqui. El health lo contesta la
	# API, y responder 200 a pelo ocultaria justo lo que hay que ver cuando se
	# cae la base de datos.
	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
		level INFO
	}

	# Log sin salida para las sondas de salud. El healthcheck de Docker pide
	# /api/v1/health cada 10 segundos y, sin esto, el access log se llena de
	# ruido que tapa justo las lineas que importan en un incidente.
	#
	# Hace falta un log CON NOMBRE y `log_name` por dos motivos de Caddy 2.11:
	# la opcion `exclude` del `log` de sitio no existe, y el `log` dentro de
	# un `handle` o de un `route` devuelve un `namedCustomLog` que el adaptador
	# rechaza ("only handler directives can be used in routes"). `log_name` si
	# es un handler.
	log salud {
		output discard
	}

	route {
		handle /api/* {
			# OJO: la sonda la responde la API de verdad. Servirla desde aqui
			# con un 200 fijo ocultaria precisamente lo que hay que ver cuando se
			# cae la base de datos.
			@health path /api/v1/health
			route @health {
				log_name salud
				reverse_proxy api:3000
			}

			reverse_proxy api:3000 {
				header_up X-Forwarded-Proto https
				# Se SOBRESCRIBE el X-Forwarded-For con la IP real en lugar de
				# heredarlo. Depender de un default del comportamiento de Caddy
				# para una decision de seguridad es fragile; el API ademas
				# limita que rangos se creen (`trustProxy` en app.ts).
				header_up X-Forwarded-For {remote_host}
			}
		}

		# -----------------------------------------------------------------
		# Frontend
		# -----------------------------------------------------------------
		handle {
			reverse_proxy web:80 {
				header_up X-Forwarded-Proto https
			}
		}
	}
}
